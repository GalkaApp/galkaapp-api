# Copy to /var/galka/.env on the server, fill in real values, chmod 600.
# Compose reads it from the directory it runs in; nothing here is ever committed.
#
#   ssh root@<host> 'install -d -m 700 /var/galka'
#   scp .env root@<host>:/var/galka/.env && ssh root@<host> 'chmod 600 /var/galka/.env'

# Postgres role password. Also spliced into TODOAPI_DATABASE_URL by compose, so
# it is set in one place. Changing it after the volume exists needs an
# `ALTER ROLE galka WITH PASSWORD ...` too — the value only initialises an
# empty data directory.
POSTGRES_PASSWORD=

# HTTP Basic credentials for /admin, which is reachable from the internet.
TODOAPI_ADMIN_USERNAME=admin
TODOAPI_ADMIN_PASSWORD=

# Where Let's Encrypt sends expiry warnings. Not secret, but it is a personal
# address and this repo is public.
ACME_EMAIL=

# Shepta project id for the landing-page counter. Leave empty to serve no
# analytics script at all.
TODOAPI_SHEPTA_PROJECT=
